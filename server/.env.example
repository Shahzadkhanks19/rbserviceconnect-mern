# Core server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rbserviceconnect
# Use a cryptographically random value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary: candidate resumes and messaging attachments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial administrator bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=RB
ADMIN_LAST_NAME=Admin
# Keep false in normal operation. Enable only intentionally when rotating the bootstrap admin password.
ADMIN_SYNC_PASSWORD=false
