# Core server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rbserviceconnect
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-characters
CLIENT_URL=http://localhost:5173

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay promotion checkout
# Key secret is server-only. Never expose it to the client or commit real credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Initial administrator bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=RB
ADMIN_LAST_NAME=Admin
ADMIN_SYNC_PASSWORD=false
