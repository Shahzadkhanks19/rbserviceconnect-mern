# Core server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rbserviceconnect
# Use a cryptographically random value of at least 32 characters locally and 48+ characters in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-characters
# Exact frontend origin. Production must use HTTPS and must not include a trailing path.
CLIENT_URL=http://localhost:5173

# Transactional email (Resend)
# Required for production password reset and branded notification delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary: candidate resumes and messaging attachments
# Configure all three together in production if uploads are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial administrator bootstrap
# These are only used to ensure the bootstrap administrator exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=RB
ADMIN_LAST_NAME=Admin
# Keep false in normal operation. Enable only intentionally when rotating the bootstrap admin password, then set it back to false.
ADMIN_SYNC_PASSWORD=false
