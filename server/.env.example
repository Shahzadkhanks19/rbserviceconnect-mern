# Core server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rbserviceconnect
MONGODB_MAX_POOL_SIZE=20
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-characters
CLIENT_URL=http://localhost:5173

# Transactional email (Resend)
# Development can run without these values; verification/reset links are logged to the server console.
# Production should use a verified Resend sending domain, for example:
# EMAIL_FROM=RB Service Connect <noreply@example.com>
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary uploads
# Required in production for resume uploads and message attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay checkout + webhook verification
# Key secret and webhook secret are server-only. Never expose them to the client or commit real credentials.
# Configure all three when payment features are enabled in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Portfolio-only AutoPay simulation
# Production defaults to disabled. Set true only when intentionally demonstrating the simulated AutoPay feature.
ENABLE_DEMO_AUTOPAY=false
DEMO_AUTOPAY_FORCE_FAILURE=false

# Initial administrator bootstrap
# Use a strong unique password and rotate/remove bootstrap credentials after the intended admin account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=RB
ADMIN_LAST_NAME=Admin
ADMIN_SYNC_PASSWORD=false
